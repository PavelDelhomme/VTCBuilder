# ============================================
# VTCBuilder - Configuration Backend Django
# ============================================
# Copiez ce fichier vers backend-django/.env et modifiez les valeurs

# ============================================
# BASE DE DONNÉES
# ============================================
DB_ENGINE=django_tenants.postgresql_backend
DB_NAME=vtcbuilder
DB_USER=vtcbuilder_user
DB_PASSWORD=vtcbuilder_password
DB_HOST=postgres
DB_PORT=5432

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# SÉCURITÉ
# ============================================
SECRET_KEY=django-insecure-change-this-in-production-minimum-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================
# URL FRONTEND (IMPORTANT POUR LES EMAILS)
# ============================================
FRONTEND_URL=http://localhost:9494

# ============================================
# CONFIGURATION EMAIL SMTP
# ============================================
EMAIL_HOST=ssl0.ovh.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=test@delhomme.ovh
EMAIL_HOST_PASSWORD=votre-mot-de-passe-email
DEFAULT_FROM_EMAIL=noreply@vtcbuilder.com

# ============================================
# STRIPE (OPTIONNEL)
# ============================================
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# ============================================
# GOOGLE MAPS (OPTIONNEL)
# ============================================
GOOGLE_MAPS_API_KEY=
