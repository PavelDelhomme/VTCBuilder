FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.hubera.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app/
RUN chmod +x /app/hubera_entrypoint.sh \
    && mkdir -p /app/media /app/static /app/staticfiles /tmp/vtcbuilder-logs

EXPOSE 8000
CMD ["bash", "/app/hubera_entrypoint.sh"]
